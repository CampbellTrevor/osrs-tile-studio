# Copy to .env.local for local API development. Never commit .env.local.
# These are SERVER-ONLY values. Never prefix them with VITE_ or NEXT_PUBLIC_.
FEEDBACK_GITHUB_REPOSITORY=CampbellTrevor/osrs-tile-studio
# Fine-grained GitHub token restricted to this repository, Issues: read/write.
FEEDBACK_GITHUB_TOKEN=
# Optional in Render: defaults to RENDER_EXTERNAL_URL. Required for custom domains.
# PUBLIC_ORIGIN=https://your-site.example
# npm run dev:api uses http://127.0.0.1:5173 by default.
